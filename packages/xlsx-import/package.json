{
  "name": "@auctionit/xlsx-import",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./coerce": {
      "types": "./src/coerce.ts",
      "default": "./dist/coerce.js"
    },
    "./date": {
      "types": "./src/date.ts",
      "default": "./dist/date.js"
    },
    "./headers": {
      "types": "./src/headers.ts",
      "default": "./dist/headers.js"
    },
    "./read-xlsx": {
      "types": "./src/read-xlsx.ts",
      "default": "./dist/read-xlsx.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@auctionit/messages": "workspace:*",
    "@auctionit/lib": "workspace:*",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
