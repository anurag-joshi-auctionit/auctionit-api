{
  "name": "@auctionit/xlsx-export",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./build-rows-xlsx": {
      "types": "./src/build-rows-xlsx.ts",
      "default": "./dist/build-rows-xlsx.js"
    },
    "./filename": {
      "types": "./src/filename.ts",
      "default": "./dist/filename.js"
    },
    "./ignore-number-as-text": {
      "types": "./src/ignore-number-as-text.ts",
      "default": "./dist/ignore-number-as-text.js"
    },
    "./inject-sheet-logo": {
      "types": "./src/inject-sheet-logo.ts",
      "default": "./dist/inject-sheet-logo.js"
    },
    "./report-header": {
      "types": "./src/report-header.ts",
      "default": "./dist/report-header.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
