{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/index.ts",
    "src/api.ts",
    "src/live-auction.ts",
    "src/live-transport.ts",
    "src/download-blob.ts",
    "src/download-authenticated-blob.ts",
    "src/**/*.test.ts"
  ]
}
