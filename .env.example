DATABASE_URL=postgres://postgres:postgres@localhost:5432/auctionit
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Set to true when behind nginx / a load balancer so req.ip is the real client
# (required for auction IP Address Restriction). See DEPLOY.md.
# TRUST_PROXY=true

# MSSQL connection (required for Phase B–C seeds and mssql:* maintenance scripts)
# MSSQL_SERVER=
# MSSQL_PORT=1433
# MSSQL_USER=
# MSSQL_PASSWORD=
# MSSQL_DATABASE=
# MSSQL_ENCRYPT=true
# MSSQL_TRUST_SERVER_CERTIFICATE=true

# Bank account field encryption (AES-256-GCM, base64-encoded 32 bytes).
# Generate: openssl rand -base64 32
# SENSITIVE_DATA_ENCRYPTION_KEY=

# Legacy decrypt — TripleDES bank fields when seeding from MSSQL.
# LEGACY_BANK_ENCRYPTION_KEY=MyComplexKey
# TempBidderInfo — plain registration uploads for seed:bidder-documents (unified file migration):
# LEGACY_BIDDER_TEMP_INFO_PATH=/path/to/UploadedFiles/TempBidderInfo
# LEGACY_BIDDER_TEMP_INFO_PATH=https://legacy.example.com/UploadedFiles/TempBidderInfo
# Legacy service invoice files for seed:service-invoices:
# LEGACY_SERVICE_INVOICE_ANNEXURE_DIR=/path/to/UploadedFiles/InvoiceAnnexure
# LEGACY_SERVICE_INVOICE_PDF_DIR=/path/to/PdfInvoiceFiles/ServiceInvoiceInfo
# LEGACY_SERVICE_INVOICE_PDF_DIR=https://legacy.example.com/PdfInvoiceFiles/ServiceInvoiceInfo
# Legacy subscription invoice PDFs for seed:subscription-documents:
# LEGACY_SUBSCRIPTION_INVOICE_PDF_DIR=/path/to/PdfInvoiceFiles/PaymentInfoReport
# LEGACY_SUBSCRIPTION_INVOICE_PDF_DIR=https://legacy.example.com/PdfInvoiceFiles/PaymentInfoReport

# R2 file storage (bidder documents)
# Bucket per environment: auctionit-local (dev) | auctionit-staging (staging).
# R2_BUCKET=auctionit-local
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Owner seed (admin users). Prefer emails; or a single SEED_OWNER_LOGIN.
# SEED_OWNER_EMAILS=anurag.joshi@auctionit.in,kumar.abhinav@auctionit.in
# SEED_OWNER_LOGIN=

# Email transport — SendGrid when SENDGRID_API_KEY is set; otherwise SMTP.
# EMAIL_HOST=mail.auctionit.in
# EMAIL_PORT=25
# EMAIL_SECURE=false
# EMAIL_USERNAME=auction-01@auctionit.in
# EMAIL_PASSWORD=
# EMAIL_FROM_NAME=AuctionIt
# Optional SendGrid (overrides SMTP when key is present):
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=noreply@auctionit.in
# SENDGRID_FROM_NAME=AuctionIt
# Optional dispatch / worker tuning (defaults shown):
# EMAIL_DISPATCH_MAX_ATTEMPTS=5
# EMAIL_DISPATCH_CONCURRENCY=5
# EMAIL_RATE_PER_SECOND=10
# EMAIL_WORKER_BATCH_SIZE=50
# EMAIL_WORKER_IDLE_MS=5000
# EMAIL_RETRY_BASE_MS=30000
# EMAIL_RETRY_MAX_MS=900000
# EMAIL_STUCK_RECLAIM_MS=300000
